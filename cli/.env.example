# Copiez ce fichier en .env (jamais commité). Les valeurs sont lues au démarrage
# depuis ./.env puis ~/.mcp-terminal/.env, sans écraser les variables déjà définies.
GITHUB_TOKEN=
ELEVENLABS_API_KEY=
FIREBASE_SERVICE_ACCOUNT=
MCP_AUTH_TOKEN=

# Optionnel
# MCP_TERMINAL_HOME=~/.mcp-terminal
# MCP_TERMINAL_TIMEOUT_MS=60000
# MCP_TERMINAL_LOG_LEVEL=warn        # silent | error | warn | info | debug
# MCP_TERMINAL_LOG_FILE=/chemin/vers/mcp-terminal.log
