{
  "name": "mcp-terminal",
  "version": "1.0.0",
  "description": "MUSLIM MCP TERMINAL — terminal CLI universel (client MCP) pour serveurs MCP locaux et distants",
  "type": "module",
  "license": "MIT",
  "bin": {
    "mcp-terminal": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/cli.js",
    "dev": "tsc -p tsconfig.json --watch",
    "demo:server": "node dist/examples/demo-server.js",
    "test": "npm run build && node --test dist/tests/config.test.js dist/tests/serverManager.test.js dist/tests/mcpClient.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0-beta.1",
    "@modelcontextprotocol/server": "^2.0.0-beta.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0"
  }
}
